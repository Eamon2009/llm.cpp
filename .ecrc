{
  "Verbose": false,
  "Debug": false,
  "Version": false,
  "Invert": false,
  "Format": "default",
  "Exclude": [
    "^\\.git/",
    "^\\.github/workflows/",
    "^assets/.*",
    "^docs/.*",
    "^engine/logs/.*",
    "\\.bin$",
    "\\.pt$",
    "\\.exe$",
    "input\\.txt$"
  ],
  "Disable": {
    "TrimTrailingWhitespace": false,
    "EndOfLine": false,
    "InsertFinalNewline": false,
    "IndentSize": false,
    "Indentation": false
  }
}